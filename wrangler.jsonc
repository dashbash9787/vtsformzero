{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vtsformzero",
	"compatibility_date": "2025-04-04",
	"compatibility_flags": [
        "nodejs_compat"
    ],
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "formzero",
			"database_id": "0f11ec74-2135-476f-a558-3183d33cf4d7",
		}
	]
}